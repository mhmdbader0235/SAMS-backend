# ─── PostgreSQL (shared server, one DB per tenant) ───────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=change-me-in-production
DB_NAME=doumind_db

# ─── Per-tenant database names ───────────────────────────────────────────────
TENANT_A_DB_NAME=tenant_a_db
TENANT_B_DB_NAME=tenant_b_db
TENANT_C_DB_NAME=tenant_c_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Algorithm: HS256 (secret key) or RS256 (provide key file paths below)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── RS256 key paths (only required if JWT_ALGORITHM=RS256) ──────────────────
JWT_PRIVATE_KEY_PATH=deploy/certs/key.pem
JWT_PUBLIC_KEY_PATH=deploy/certs/cert.pem

# ─── App secrets ─────────────────────────────────────────────────────────────
# Code teachers must enter at registration — keep this private
TEACHER_INVITE_CODE=SCHOOL-STAFF-2026
