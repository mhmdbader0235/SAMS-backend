# ─── PostgreSQL (shared server, schema-per-tenant in one database) ───────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=change-me-in-production
DB_NAME=doumind_db

# ─── docker-compose.yml only ──────────────────────────────────────────────────
# Consumed directly by the `db` and `keycloak` services (Postgres' own
# POSTGRES_PASSWORD env var, and Keycloak's KC_DB_PASSWORD) -- keep this equal
# to DB_PASSWORD above. When running via `docker compose up`, docker-compose.yml
# wires the `backend` container's own DB_PASSWORD from THIS var, not from
# DB_PASSWORD, so this is the one that actually matters once you're in Docker.
POSTGRES_PASSWORD=change-me-in-production
# Keycloak's own admin console bootstrap password (docker-compose.yml
# `keycloak` service). Change before any non-local deploy.
KEYCLOAK_ADMIN_PASSWORD=change-me-in-production

# ─── Per-tenant database names (DEAD — do not use) ───────────────────────────
# database.py's get_pool() always force-overwrites the tenant DB name back to
# DB_NAME above, so these are never actually read. Queued for removal in the
# Step 6 Alembic migration — see FIX_PLAN.md Step 6.
TENANT_A_DB_NAME=tenant_a_db
TENANT_B_DB_NAME=tenant_b_db
TENANT_C_DB_NAME=tenant_c_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Algorithm: HS256 (secret key) or RS256 (provide key file paths below)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=5000

# ─── RS256 key paths (only required if JWT_ALGORITHM=RS256) ──────────────────
JWT_PRIVATE_KEY_PATH=deploy/certs/key.pem
JWT_PUBLIC_KEY_PATH=deploy/certs/cert.pem

# ─── App secrets ─────────────────────────────────────────────────────────────
# Code teachers must enter at registration — keep this private
TEACHER_INVITE_CODE=SCHOOL-STAFF-2026

# ─── Keycloak (SSO / OIDC token verification) ─────────────────────────────────
KEYCLOAK_URL=http://localhost:8000
KEYCLOAK_REALM=SAMS
# Both default from KEYCLOAK_URL/KEYCLOAK_REALM above — override only if the
# issuer Keycloak actually stamps into `iss` differs from that (e.g. a
# different public hostname in production). Confirm against a real token.
# KEYCLOAK_ISSUER=http://localhost:8000/realms/SAMS
# KEYCLOAK_JWKS_URL=http://localhost:8000/realms/SAMS/protocol/openid-connect/certs
# Comma-separated list of acceptable `aud` values for end-user access tokens.
# SAMS-realm.json defines no audience mapper, so which client ID (or the
# built-in "account") ends up in `aud` has not been confirmed against a live
# token yet. Narrow this to the single real value once confirmed.
KEYCLOAK_AUDIENCE=account,apisix,frontend
KEYCLOAK_JWKS_REFRESH_SECONDS=300
# APISIX-level bearer-token check (gateway/apisix/apisix.yaml openid-connect plugin, see
# back/docs/architecture/GATEWAY_AUTH_HARDENING_PLAN.md Phase 2). This is the "apisix"
# confidential client's secret from the Keycloak admin console (Clients > apisix >
# Credentials) -- NOT the "apisix_client_secret_placeholder" value shipped in
# SAMS-realm.json, which is a placeholder only and must never be used as a real secret.
APISIX_KC_CLIENT_SECRET=changeme
# WebAuthn Passkey (Passwordless) RP ID -- bare hostname, no scheme/port. Must
# be a registrable-domain match for whatever origin performs the WebAuthn
# ceremony. Login happens on Keycloak's own hosted UI (redirect-based OIDC,
# not a form on the SPA's origin), so this should match KEYCLOAK_URL's host,
# not the frontend's. Only read by setup_passkeys.py, not the running API.
WEBAUTHN_RP_ID=localhost

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of EXTRA browser origins allowed on top of the fixed
# localhost/127.0.0.1 dev ports app/main.py always allows. Set this to the
# real public URL the frontend is served from once known (e.g.
# https://sams.yourschool.com or http://<server-ip>:9080) -- until then,
# browser requests from that origin are blocked by CORS before they reach a
# route.
CORS_EXTRA_ORIGINS=

# ─── Outbound links (emails) ────────────────────────────────────────────────
# Base URL used to build links sent in real invite/reset emails (see
# app/utils/email.py, app/domains/invitations/service.py). Must be the
# PUBLIC frontend URL a parent/teacher's browser can reach -- never a
# Docker-internal service name like http://frontend:80. Placeholder until the
# real domain/IP is known.
FRONTEND_URL=http://localhost:3000

# ─── docker-compose.yml only: frontend build arg ────────────────────────────
# Baked into the frontend's static JS bundle at BUILD time (see
# front/src/api.js -- Vite has no runtime env, so changing this requires
# `docker compose build frontend` again, not just a restart). Must be the
# PUBLIC gateway URL a browser can reach, never a Docker-internal name like
# http://backend:8001. Left unset here on purpose until the real deploy
# domain/IP is known -- docker-compose.yml falls back to an obvious
# placeholder so a forgotten override fails loudly instead of building a
# frontend that silently calls the wrong host.
VITE_API_URL=
